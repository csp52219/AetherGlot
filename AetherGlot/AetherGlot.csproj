<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <!-- SDK 15 sets: net10.0-windows, LangVersion=14.0, Nullable, AllowUnsafeBlocks, ProduceReferenceAssembly, x64 -->
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AetherGlot</RootNamespace>
    <AssemblyName>AetherGlot</AssemblyName>
    <Version>1.0.0.0</Version>
    <!-- DalamudPackager manifest -->
    <Name>AetherGlot</Name>
    <InternalName>AetherGlot</InternalName>
    <Author>AetherGlot Contributors</Author>
    <Punchline>FFXIV in-game chat translation powered by LLM APIs</Punchline>
    <Description>Translates FFXIV chat in real time with an LLM (OpenAI, Claude, Gemini, LiteLLM or any OpenAI-compatible endpoint). Party bubbles, translation log, send preview with tone and back-translation, game-data and community dictionaries, auto-translate aware. UI in English, Japanese, German and French.</Description>
    <Tags>translation;chat;ai;llm</Tags>
    <RepoUrl>https://github.com/csp52219/AetherGlot</RepoUrl>
  </PropertyGroup>

  <!-- CheapLoc is in the Dalamud dev folder but is not auto-referenced by the SDK -->
  <ItemGroup>
    <Reference Include="CheapLoc" Private="false" />
  </ItemGroup>

  <!-- Core class library (no Dalamud deps — also referenced by AetherGlot.Tests) -->
  <ItemGroup>
    <ProjectReference Include="..\AetherGlot.Core\AetherGlot.Core.csproj" />
  </ItemGroup>

  <!-- Bundled community dictionary (used offline / until the first download) -->
  <ItemGroup>
    <Content Include="..\community-glossary\glossary.json" Link="community-glossary.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy locale files to output directory -->
  <ItemGroup>
    <Content Include="loc\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
